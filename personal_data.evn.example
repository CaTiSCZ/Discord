DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=123456789012345678  # ID kanálu, kde bot čte hody
ROLL_FILE=roll_dish.txt        # Výstupní soubor s hody
LAST_ID_FILE=last_id.txt       # Soubor s posledním ID zprávy

